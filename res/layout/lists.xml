<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lists_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal">

        <info.ro_che.auhasard.RuledEditText
            android:id="@+id/list_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/box"
            android:fontFamily="@font/cmu_serif"
            android:gravity="top|start"
            android:hint="@string/list_hint"
            android:imeOptions="flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:lineHeight="28dp"
            android:paddingStart="42dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/ink"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <info.ro_che.auhasard.TileLayout
                android:id="@+id/paste"
                style="@style/Tile">

                <ImageView
                    style="@style/TileIcon"
                    android:src="@drawable/ic_paste" />

                <TextView
                    style="@style/TileLabel"
                    android:text="@string/paste" />
            </info.ro_che.auhasard.TileLayout>

            <info.ro_che.auhasard.TileLayout
                android:id="@+id/copy"
                style="@style/Tile"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/TileIcon"
                    android:src="@drawable/ic_copy" />

                <TextView
                    style="@style/TileLabel"
                    android:text="@string/copy" />
            </info.ro_che.auhasard.TileLayout>

            <info.ro_che.auhasard.TileLayout
                android:id="@+id/save"
                style="@style/Tile"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/TileIcon"
                    android:src="@drawable/ic_save" />

                <TextView
                    style="@style/TileLabel"
                    android:text="@string/save" />
            </info.ro_che.auhasard.TileLayout>

            <info.ro_che.auhasard.TileLayout
                android:id="@+id/saved"
                style="@style/Tile"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/TileIcon"
                    android:src="@drawable/ic_saved" />

                <TextView
                    style="@style/TileLabel"
                    android:text="@string/saved" />
            </info.ro_che.auhasard.TileLayout>

            <info.ro_che.auhasard.TileLayout
                android:id="@+id/clear"
                style="@style/Tile"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/TileIcon"
                    android:src="@drawable/ic_clear" />

                <TextView
                    style="@style/TileLabel"
                    android:text="@string/clear" />
            </info.ro_che.auhasard.TileLayout>
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <include
        android:id="@+id/list_result"
        layout="@layout/result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/draw_item"
            style="@style/ActionButton.Primary"
            android:layout_marginEnd="12dp"
            android:text="@string/draw" />

        <Button
            android:id="@+id/shuffle_items"
            style="@style/ActionButton"
            android:text="@string/shuffle" />
    </LinearLayout>
</LinearLayout>
