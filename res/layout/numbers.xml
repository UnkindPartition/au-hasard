<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/numbers_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            style="@style/RangeLabel"
            android:labelFor="@+id/min"
            android:text="@string/from" />

        <EditText
            android:id="@+id/min"
            style="@style/NumberInput"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:imeOptions="actionNext|flagNoPersonalizedLearning" />

        <TextView
            style="@style/RangeLabel"
            android:labelFor="@+id/max"
            android:text="@string/to" />

        <EditText
            android:id="@+id/max"
            style="@style/NumberInput"
            android:layout_marginStart="10dp"
            android:imeOptions="actionDone|flagNoPersonalizedLearning" />
    </LinearLayout>

    <TextView
        android:id="@+id/numbers_note"
        style="@style/RangeLabel"
        android:layout_marginTop="16dp"
        android:freezesText="true"
        android:textSize="16sp"
        android:visibility="gone" />

    <include
        android:id="@+id/numbers_result"
        layout="@layout/result" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/draw_number"
            style="@style/ActionButton.Primary"
            android:layout_marginEnd="12dp"
            android:text="@string/draw" />

        <Button
            android:id="@+id/shuffle_numbers"
            style="@style/ActionButton"
            android:text="@string/shuffle" />
    </LinearLayout>
</LinearLayout>
