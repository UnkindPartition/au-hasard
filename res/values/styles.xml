<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text in the small caps font: lowercase letters come out as small capitals. -->
    <style name="SmallCaps">
        <item name="android:fontFamily">@font/lm_roman_caps</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Tab" parent="SmallCaps">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">26dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/tab</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="RangeLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lm_roman_italic</item>
        <item name="android:textColor">@color/soft</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NumberInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/box</item>
        <item name="android:fontFamily">@font/lm_roman</item>
        <item name="android:gravity">end</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">numberSigned</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="ActionButton" parent="SmallCaps">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ActionButton.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <!-- A tile is an icon above a label, centered together. -->
    <style name="Tile">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TileIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/on_outline</item>
    </style>

    <style name="TileLabel" parent="SmallCaps">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/on_outline</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
